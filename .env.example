# Shared world. Leave unset to play a normal single-tab game: every WebMCP tool
# still works, the tab just isn't synced to anyone else.
#
# Set both to put every tab that joins the same room on ONE shared avatar.
# A free Supabase project is enough - only Realtime is used, no tables, no auth.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Which world to join. Also overridable per tab with ?room=<name>.
REACT_APP_ROOM=kanto
